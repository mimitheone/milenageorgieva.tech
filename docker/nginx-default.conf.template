server {
    listen       ${PORT};
    listen  [::]:${PORT};
    server_name  localhost;
    root   /usr/share/nginx/html;
    index  index.html;
    location / {
        try_files $uri $uri/ $uri/index.html =404;
    }
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
